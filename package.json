{
  "name": "iva-arenda-nvk",
  "private": true,
  "description": "Ива — маркетплейс аренды инструмента (сайт + приложение). Служебный файл только для инструментов разработки; на сайт не влияет.",
  "scripts": {
    "dev": "node tools/dev-server.js",
    "check": "bash tools/check.sh",
    "check:fast": "bash tools/check.sh --fast",
    "check:only": "bash tools/check.sh --only",
    "check:list": "bash tools/check.sh --list",
    "assets:check": "node tools/asset-version.js check",
    "assets:list": "node tools/asset-version.js list",
    "assets:bump": "node tools/asset-version.js bump",
    "apk:report": "node tools/apk-inventory.js",
    "map": "node tools/page-map.js",
    "snapshot": "bash tools/snapshot.sh",
    "screens": "node tools/screenshot-baseline.js --save",
    "screens:check": "node tools/screenshot-baseline.js --check",
    "test": "bash tools/check.sh"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
